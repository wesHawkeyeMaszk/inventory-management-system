{
  "title": "Inventory Management API",
  "description": "Request rate/latency/errors, cache effectiveness, and HPA scaling behaviour for the inventory-app Deployment. Requires a Prometheus datasource scraping GET /metrics (see k8s/app/service.yaml annotations) and kube-state-metrics for the HPA panels.",
  "schemaVersion": 39,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(flask_http_request_total[5m])) by (path, method)",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "p95 latency by endpoint",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(flask_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "5xx error rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(rate(flask_http_request_total{status=~\"5..\"}[5m])) / sum(rate(flask_http_request_total[5m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cache hit ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(inventory_cache_result_total{result=\"hit\"}[5m])) / sum(rate(inventory_cache_result_total[5m]))",
          "legendFormat": "hit ratio"
        }
      ]
    },
    {
      "id": 5,
      "title": "HPA current vs desired replicas",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": "${DS_PROMETHEUS}",
      "description": "Requires kube-state-metrics. Watch this climb toward maxReplicas (10) while scripts/load_test.js is running.",
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{horizontalpodautoscaler=\"inventory-app-hpa\", namespace=\"inventory\"}",
          "legendFormat": "current"
        },
        {
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler=\"inventory-app-hpa\", namespace=\"inventory\"}",
          "legendFormat": "desired"
        }
      ]
    },
    {
      "id": 6,
      "title": "Pod CPU utilization vs HPA target (60%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"inventory\", pod=~\"inventory-app-.*\"}[5m])) by (pod) / sum(kube_pod_container_resource_requests{namespace=\"inventory\", pod=~\"inventory-app-.*\", resource=\"cpu\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}
